# evalkit configuration. Copy to .env (never commit it) and export, e.g. `set -a; . ./.env; set +a`.

# Judge provider: "bedrock" (boto3 Converse API, default) or "bedrock-openai" (Bedrock's
# OpenAI-compatible gateway; requires the `bedrock-openai` extra).
EVALKIT_JUDGE_PROVIDER=bedrock
# Required. Model ID (Bedrock model/inference-profile ID, or the gateway's own model name
# for "bedrock-openai", e.g. openai.gpt-oss-120b) that supports forced tool/function calls.
EVALKIT_JUDGE_MODEL=
EVALKIT_JUDGE_TEMPERATURE=0
# Per-request timeout in seconds. Provider errors and timeouts are not retried.
EVALKIT_JUDGE_TIMEOUT=60
EVALKIT_DB_PATH=./evalkit.db

# --- provider: bedrock (default) ---
# AWS credentials/region are read by boto3 via the standard AWS chain.
AWS_REGION=us-east-1
# AWS_PROFILE=

# --- provider: bedrock-openai ---
# EVALKIT_JUDGE_API_KEY=
# Optional; defaults to https://bedrock-mantle.<region>.api.aws/v1
# EVALKIT_JUDGE_BASE_URL=
